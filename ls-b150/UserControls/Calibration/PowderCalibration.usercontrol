[
  {
    "event": "btRecipeData_1.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%niBatchWeight_1::Value%/ctrl%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%s%PLC1.MainBalance.WeightSetpoint%/s%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%niDoseCalibration_1::Value%/ctrl%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%%s%PLC1.Recipes.MachineRecipe.PowderConfig%/s%[%pp%LineNumber%/pp%-1].Dosage%/f%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%niInjectionTimeCalib_1::Value%/ctrl%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%%s%PLC1.Recipes.MachineRecipe.PowderConfig%/s%[%pp%LineNumber%/pp%-1].InjectionDelay%/f%"
        },
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.HMI_TRATADORA_B300.PopUpAlert",
        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%l%Loaded%/l%.toUpperCase()%/f%"
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
