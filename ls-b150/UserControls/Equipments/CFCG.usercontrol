        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%PLC1.CFCG.Control.Close%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      }
    ]
  }
]
</script>







