        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "var popupElement = document.getElementById(\"popUp_1\");",
          "TcHmi.TopMostLayer.remove(this, popupElement);"
        ],
        "injectContextObject": false,
        "asyncWait": true,
        "waitMode": "Synchronous"
      }
    ]
  }
]
</script>

