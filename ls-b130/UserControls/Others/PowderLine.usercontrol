        "fnParams": [
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%s%PLC1.Powders.ProductAttached%/s%"
          },
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%pp%LineNumber%/pp%-1%/f%"
          },
          {
            "objectType": "Symbol",
            "valueType": "Integer",
            "symbolExpression": "%ctrl%cbPowderSelect::SelectedId%/ctrl%"
          }
        ],
        "asyncWait": true
      },
      {
        "objectType": "Function",
        "active": true,
        "fn": "TcHmi.Functions.Beckhoff.SetElementByIndex",
        "fnParams": [
          {
            "objectType": "Symbol",
            "symbolExpression": "%s%PLC1.Powders.CircuitOffset%/s%"
          },
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%pp%LineNumber%/pp%-1%/f%"
          },
          {
            "objectType": "Symbol",
            "valueType": "tchmi:general#/definitions/String",
            "symbolExpression": "%f%%s%PLC1.Powders.PowdersTable%/s%[%ctrl%cbPowderSelect::SelectedId%/ctrl%-1].Correction%/f%"
          }
        ],
        "asyncWait": true
      }
    ]
  },
  {
    "event": "cbPowderSelect.onAttached",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%cbPowderSelect::SelectedId%/ctrl%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/String",
          "symbolExpression": "%f%TcHmi.Functions.Beckhoff.GetElementByIndex(%s%PLC1.Powders.ProductAttached%/s%, %pp%LineNumber%/pp%-1)%/f%"
        },
        "asyncWait": true
      }
    ]
  }
]
</script>








