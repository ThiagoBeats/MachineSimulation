  "trigger": [
    {
      "event": "%s%PLC1.MainBalance.InfeedLateness%/s%",
      "actions": [
        {
          "objectType": "Condition",
          "active": true,
          "parts": [
            {
              "if": [
                {
                  "compare1": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:general#/definitions/String",
                    "symbolExpression": "%s%PLC1.MainBalance.InfeedLateness%/s%"
                  },
                  "compare2": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/BOOL",
                    "value": true
                  },
                  "compareOperator": "==",
                  "logic": null
                }
              ],
              "then": [
                {
                  "objectType": "Function",
                  "active": true,
                  "fn": "TcHmi.Functions.B120_HMI.PopUpDyn",
                  "fnParams": [
                    {
                      "objectType": "StaticValue",
                      "valueType": "tchmi:general#/definitions/String",
                      "value": "1"
                    },
                    {
                      "objectType": "StaticValue",
                      "valueType": "tchmi:framework#/definitions/TcHmi.Controls.System.TcHmiPopup.TargetFile",
                      "value": {
                        "path": "UserControls/Others/LatenessOnBalanceInfeed.usercontrol"
                      }
                    },
                    {
                      "objectType": "StaticValue",
                      "valueType": "tchmi:general#/definitions/Number",
                      "value": 40.0
                    },
                    {
                      "objectType": "StaticValue",
                      "valueType": "tchmi:general#/definitions/Number",
                      "value": 50.0
                    },
                    {
                      "objectType": "StaticValue",
                      "valueType": "tchmi:framework#/definitions/ClassNameList",
                      "value": [
                        "fadein"
                      ]
                    }
                  ],
                  "asyncWait": true
                }
              ]
            },
            {
              "else": []
            }
          ],
          "asyncWait": true
        }
      ]
    },
    {
      "event": "%s%PLC1.Alarms.HeaderTextValue%/s%",
      "actions": [
        {
          "objectType": "Condition",
          "active": true,
          "parts": [
            {
              "if": [
                {
                  "compare1": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:general#/definitions/INT",
                    "symbolExpression": "%s%PLC1.Alarms.HeaderTextValue%/s%"
                  },
                  "compare2": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/INT",
                    "value": 1
                  },
                  "compareOperator": "==",
                  "logic": null
                },
                {
                  "compare1": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:general#/definitions/String",
                    "symbolExpression": "%s%PLC1.Alarms.HeaderTextValue%/s%"
                  },
                  "compare2": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/INT",
                    "value": 2
                  },
                  "compareOperator": "==",
                  "logic": "OR"
                }
              ],
              "then": [
                {
                  "objectType": "Function",
                  "active": true,
                  "fn": "TcHmi.Functions.B120_HMI.AlarmSound",
                  "fnParams": [
                    {
                      "objectType": "StaticValue",
                      "valueType": "tchmi:general#/definitions/Number",
                      "value": null
                    }
                  ],
                  "asyncWait": true
                }
              ]
            },
            {
              "elseif": [
                {
                  "compare1": {
                    "objectType": "Symbol",
                    "valueType": "tchmi:general#/definitions/String",
                    "symbolExpression": "%s%PLC1.Alarms.HeaderTextValue%/s%"
                  },
                  "compare2": {
                    "objectType": "StaticValue",
                    "valueType": "tchmi:general#/definitions/INT",
                    "value": 3
                  },
                  "compareOperator": ">=",
                  "logic": null
                }
              ],
              "then": [
                {
                  "objectType": "Function",
                  "active": true,
                  "fn": "TcHmi.Functions.B120_HMI.AlertSound",
                  "fnParams": [
                    {
                      "objectType": "StaticValue",
                      "valueType": "tchmi:general#/definitions/Number",
                      "value": null
                    }
                  ],
                  "asyncWait": true
                }
              ]
            },
            {
              "else": []
            }
          ],
          "asyncWait": true
        }
      ]
    }
